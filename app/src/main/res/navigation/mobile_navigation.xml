    <fragment
        android:id="@+id/nav_cart"
        android:name="id.ac.polbeng.srisalmiapahma.navigationdrawerapp.CartFragment"
        android:label="@string/menu_cart"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/nav_map"
        android:name="id.ac.polbeng.srisalmiapahma.navigationdrawerapp.MapFragment"
        android:label="@string/menu_map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/nav_hotel"
